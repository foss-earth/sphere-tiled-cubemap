{
  "name": "@foss-earth/tiled-cubemap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/foss-earth/tiled-cubemap.git"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "source": "./src/core.ts",
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./schema.json": "./schema/representation.json",
    "./preparation": {
      "source": "./src/preparation.ts",
      "types": "./dist/preparation.d.ts",
      "import": "./dist/preparation.js"
    },
    "./browser": {
      "source": "./src/browser/index.ts",
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./babylon": {
      "source": "./src/browser/tileAtlas.ts",
      "types": "./dist/browser/tileAtlas.d.ts",
      "import": "./dist/browser/tileAtlas.js"
    },
    "./shaders": {
      "source": "./src/shaders.ts",
      "types": "./dist/shaders.d.ts",
      "import": "./dist/shaders.js"
    },
    "./settings": {
      "source": "./src/catalogue.ts",
      "types": "./dist/catalogue.d.ts",
      "import": "./dist/catalogue.js"
    }
  },
  "files": [
    "dist",
    "schema",
    "LICENSE",
    "README.md",
    "NOTICE",
    "AGENTS.md"
  ],
  "dependencies": {
    "@foss-earth/images": "0.1.0",
    "@foss-earth/cubemap": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "typescript": "5.9.3",
    "vitest": "4.1.6",
    "eslint": "9.39.4",
    "typescript-eslint": "8.59.3",
    "@eslint/js": "9.39.4",
    "globals": "17.6.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --tsBuildInfoFile node_modules/.tmp/typecheck.tsbuildinfo",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "test": "vitest run --maxWorkers=50%",
    "ci": "npm run check:implementation",
    "check:implementation": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "peerDependencies": {
    "@foss-earth/renderer": "0.1.0",
    "@babylonjs/core": "8.56.2",
    "@foss-earth/ui": "0.1.0"
  },
  "peerDependenciesMeta": {
    "@foss-earth/renderer": {
      "optional": true
    },
    "@babylonjs/core": {
      "optional": true
    },
    "@foss-earth/ui": {
      "optional": true
    }
  }
}
